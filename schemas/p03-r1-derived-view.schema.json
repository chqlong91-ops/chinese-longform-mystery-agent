{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/p03-r1-derived-view.schema.json",
  "title": "P03-R1 Derived View Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["view_set_id", "template_version", "views"],
  "properties": {
    "view_set_id": { "type": "string", "pattern": "^VIEWSET-[A-Z0-9-]+@v[0-9]{3}$" },
    "template_version": { "type": "string", "pattern": "^v[0-9]{3}$" },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["view_id", "kind", "target_relative"],
        "properties": {
          "view_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
          "kind": { "enum": ["current-summary", "task-summary", "recovery-summary"] },
          "target_relative": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
